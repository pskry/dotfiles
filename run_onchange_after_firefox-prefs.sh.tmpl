#!/usr/bin/env bash
# Install user.js into every Firefox profile.
#
# A profile directory is named with a random prefix that differs per machine, so chezmoi
# cannot target it directly. This reads profiles.ini and copies the file into each one.
#
# The hash below is what decides when this re-runs, and it covers both things that
# matter: the prefs themselves, and WHICH PROFILES EXIST. The second is the subtle one.
# On a machine where Firefox has never been started there is no profile to write into, so
# a plain run_onchange would do nothing once and never reconsider; naming the profile list
# means the first launch changes the hash and this runs again.
#
# A plain `run_` script would also work and was tried, but it reports as pending in every
# `chezmoi status` forever, which is a worse trade: a status that always shows something
# is a status nobody reads.
#
# prefs:    {{ include "dot_config/firefox/user.js" | sha256sum }}
# chrome:   {{ include "dot_config/firefox/userChrome.css" | sha256sum }}
# profiles: {{ output "sh" "-c" "cat \"$HOME/.mozilla/firefox/profiles.ini\" \"$HOME/.config/mozilla/firefox/profiles.ini\" \"$HOME/Library/Application Support/Firefox/profiles.ini\" 2>/dev/null | grep '^Path=' || true" | sha256sum }}
set -Eeuo pipefail

prefs="${XDG_CONFIG_HOME:-$HOME/.config}/firefox/user.js"
chrome_css="${XDG_CONFIG_HOME:-$HOME/.config}/firefox/userChrome.css"
[[ -r $prefs ]] || exit 0

# BOTH Linux locations, because Firefox moved. Recent builds keep profiles under
# XDG_CONFIG_HOME; older ones use ~/.mozilla, and a machine upgraded in place can still
# have the old one. Whichever has a profiles.ini is the live one.
roots=(
{{- if eq .chezmoi.os "darwin" }}
  "$HOME/Library/Application Support/Firefox"
{{- else }}
  "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox"
  "$HOME/.mozilla/firefox"
{{- end }}
)

for root in "${roots[@]}"; do
  [[ -r "$root/profiles.ini" ]] || continue
  # Path= is relative to the root unless IsRelative=0, which nothing this side writes.
  while read -r profile; do
    dir="$root/$profile"
    [[ -d $dir ]] || continue
    cp -f "$prefs" "$dir/user.js"
    if [[ -r $chrome_css ]]; then
      mkdir -p "$dir/chrome"
      cp -f "$chrome_css" "$dir/chrome/userChrome.css"
    fi
    echo "firefox prefs -> $profile"
  done < <(awk -F= '/^Path=/ { print $2 }' "$root/profiles.ini")
done
