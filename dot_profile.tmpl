#
# ~/.profile
#

# XDG standard =============================================================
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew =================================================================
# unset HOMEBREW_SHELLENV_PREFIX
export HOMEBREW_PREFIX='/opt/homebrew'
[ -d "$HOMEBREW_PREFIX" ] && eval "$("$HOMEBREW_PREFIX/bin/brew" shellenv)"
# export HOMEBREW_NO_ENV_HINTS='true'

if [ -f "$HOMEBREW_PREFIX/Library/Homebrew/command-not-found/handler.sh" ]; then
  source "$HOMEBREW_PREFIX/Library/Homebrew/command-not-found/handler.sh"
fi

{{ end }}
# PATH setup ===============================================================

# POSIX only -- .profile is sourced by sh too, so no [[ ]] here.
prepend_path() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) return 0 ;;
  esac
  PATH="$1${PATH:+:$PATH}"
  export PATH
}

# prepend_path no-ops when the entry is already present, leaving it at whatever
# precedence a parent process handed down. This strips it first.
prepend_path_force() {
  [ -d "$1" ] || return 0
  PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$1" | paste -sd: -)
  PATH="$1${PATH:+:$PATH}"
  export PATH
}

# For toolchains that must NOT shadow system tools.
append_path() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) return 0 ;;
  esac
  PATH="${PATH:+$PATH:}$1"
  export PATH
}

append_path "$HOME/.platformio/penv/bin"
{{ if eq .chezmoi.os "darwin" -}}
append_path "$HOMEBREW_PREFIX/opt/openjdk/bin"
append_path "$HOMEBREW_PREFIX/opt/llvm/bin"
append_path "$HOMEBREW_PREFIX/opt/make/libexec/gnubin"
{{ end }}
# Last prepend wins, so this reads bottom-up in priority order.
prepend_path "$HOME/.local/bin"

# Shims, so NON-interactive shells get the pinned toolchain too. Interactive ones
# swap these for the resolved install dirs via `mise activate`.
prepend_path_force "$HOME/.local/share/mise/shims"

{{ if eq .chezmoi.os "darwin" -}}
# To use the bundled libunwind please use the following LDFLAGS:
#   LDFLAGS="-L/opt/homebrew/opt/llvm/lib/unwind -lunwind"
# To use the bundled libc++ please use the following LDFLAGS:
#   LDFLAGS="-L/opt/homebrew/opt/llvm/lib/c++ -L/opt/homebrew/opt/llvm/lib/unwind -lunwind"

{{ end -}}
unset -f prepend_path
unset -f prepend_path_force
unset -f append_path

export EDITOR="nvim"
{{ if eq .chezmoi.os "darwin" -}}
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/llvm/lib"
export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/openjdk/include -I$HOMEBREW_PREFIX/opt/llvm/include"

# An MIT ldapsearch cannot see a ticket Apple's Heimdal kinit cached, so pin one
# implementation. Not on Linux, where it would shadow what realmd wrote.
export KRB5_CONFIG="$HOME/.krb5.conf"
{{ end -}}

if [ -f "$HOME/.secret/codeberg_token" ]; then
  CODEBERG_TOKEN="$(cat "$HOME/.secret/codeberg_token")"
  export CODEBERG_TOKEN
fi
if [ -f "$HOME/.secret/unifi_api_key" ]; then
  UNIFI_API_KEY="$(cat "$HOME/.secret/unifi_api_key")"
  export UNIFI_API_KEY
fi

export SCAMPI_FUZZY_FINDER="fzf"

# The session's own agent (systemd socket, launchd on macOS), shared with GUI apps.
"$HOME/.local/bin/ssh-add-all"

# Lets .zshrc and .bashrc tell whether a login shell already ran this.
export __PROFILE_SOURCED=1

# NOTE: uv's installer drops `. "$HOME/.local/share/../bin/env"` here. Delete it if it
# comes back: the path normalizes to one prepend_path already covers, but its own guard
# tests the unnormalized literal, so it appends a second differently-spelled copy.

# vim:ts=2:sw=2:ft=sh:fenc=utf-8
