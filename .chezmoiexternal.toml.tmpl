[".config/kitty/kitty-themes"]
    type = "git-repo"
    url = "https://github.com/dexpota/kitty-themes.git"
    refreshPeriod = "168h"
[".config/tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"
{{- /*
     The font every terminal config here names, so it is declared on EVERY machine. It
     used to be linux-only, which left macOS working purely because the font had been
     installed by hand once: a dependency nothing recorded and a rebuild would not have.

     Only the destination differs. macOS reads ~/Library/Fonts and indexes it on its own;
     Linux needs ~/.local/share/fonts and an fc-cache, which the desktop script runs.
*/ -}}
{{ if eq .chezmoi.os "darwin" }}
["Library/Fonts/JetBrainsMonoNerd"]
{{- else }}
[".local/share/fonts/JetBrainsMonoNerd"]
{{- end }}
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/JetBrainsMono.tar.xz"
    exact = true
    include = ["*.ttf"]
