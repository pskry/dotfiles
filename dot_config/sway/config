# A user config REPLACES /etc/sway/config, so it is included first: the system one carries
# the defaults and the machine's own config.d drop-ins, idle blanking among them.
include /etc/sway/config

# The thumb key sends Control, so Alt+C is copy wherever Ctrl+C is. Defined in ~/.config/xkb.
input type:keyboard {
    xkb_options parity:lalt_ctrl
    # macOS's fastest slider settings: InitialKeyRepeat 15 and KeyRepeat 2, in ms and Hz.
    repeat_delay 225
    repeat_rate 33
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
}

set $term kitty
# --no-warn, or replacing the stock foot binding raises a swaynag "errors in your config".
bindsym --no-warn $mod+Return exec $term

# The thumb key plus Space, the same movement as Cmd+Space on the Mac.
bindsym Ctrl+space exec $menu
