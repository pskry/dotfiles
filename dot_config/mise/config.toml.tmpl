# Exact versions, bumped with `mise up --bump`.
#
# Cluster clients (kubectl, opentofu, argocd) are deliberately absent: they are pinned to
# a server, not to this machine, so skrynet's own .mise.toml owns them.

[tools]
act = "0.2.89"
age = "1.3.2"
bat = "0.26.1"
# Pinned here rather than taken from each OS's packages, because they are not the same
# program in practice: Fedora's 2.70.0 takes 1.2s for a `chezmoi status` that Homebrew's
# 2.72.1 does in 0.03s on comparable work.
chezmoi = "2.73.1"
# git-delta. The registry name is `delta`.
delta = "0.20.1"
eza = "0.23.5"
fd = "10.5.0"
fzf = "0.74.5"
gh = "2.102.0"
glow = "3.0.0"
"github:Macmod/godap" = "2.12.2"
hyperfine = "2.0.0"
jq = "1.8.2"
just = "1.58.0"
k9s = "0.51.0"
lazygit = "0.66.1"
neovim = "0.12.6"
# Not a language I write in: mason installs most LSP servers from npm, so without node
# yamlls, dockerls, bashls, pyright, ansiblels and jsonls all fail and nvim looks broken
# on a fresh machine. It worked on the mac only because brew had already put node there.
node = "26.12.0"
ripgrep = "15.2.0"
# blink.cmp's fuzzy matcher is Rust. Without it the plugin falls back to a Lua matcher
# that works and is slower, which shows up as a failed build.
rust = "1.99.0"
shellcheck = "0.11.0"
shfmt = "3.14.1"
sops = "3.13.3"
starship = "1.26.0"
tmux = "3.7c"
"pipx:tmuxp" = "1.74.0"
usql = "0.21.6"
# Backs the pipx: backend.
uv = "0.12.13"
yazi = "26.9.1"
yq = "4.54.1"
zoxide = "0.10.0"

# Scoped tools. Everything above is on every machine; what follows depends on whose
# machine it is.
#
# Keyed off the SAME personal_hosts list .chezmoiignore uses, so there is one list to
# maintain, and an unknown machine is treated as work rather than silently receiving the
# personal set.
{{ if not (has .chezmoi.hostname .personal_hosts) }}
# opencode is NOT here, deliberately. Both obvious routes are broken: the npm backend
# installs with --ignore-scripts so its postinstall never runs and every invocation says
# so, and ubi fetches an AppImage that wants libfuse.so.2. It also needs a private
# endpoint and key, so it is set up by hand rather than pinned here.
{{ end -}}
