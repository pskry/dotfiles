#
# ~/.bash_profile
#
# Bash does NOT read .bashrc for login shells, which is the usual reason a login
# shell has no aliases while a terminal tab has all of them.
#

# shellcheck source=/dev/null
[ -f "$HOME/.profile" ] && . "$HOME/.profile"

# shellcheck source=/dev/null
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"

