# Governs editing the SOURCE files, which is what `chezmoi edit` opens. chezmoi never
# deploys entries beginning with a dot, so this stays in the repo.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
# Two trailing spaces are a hard line break in markdown.
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[Makefile]
indent_style = tab
