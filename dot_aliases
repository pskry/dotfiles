#
# ~/.aliases
#
# vim:ts=2:sw=2:ft=sh:fenc=utf-8

# ls aliases ===============================================================

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group --group-directories-first --icons --color=auto'
fi

alias l='ls -l'
alias ll='ls -la'

# grep aliases =============================================================

# NOTE: do NOT alias grep to rg. In rg `-r` is --replace, not --recursive, so a reflex
# `grep -rln foo` silently rewrites the matches instead of erroring. See scampi#454.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias xzegrep='xzegrep --color=auto'
alias xzfgrep='xzfgrep --color=auto'
alias xzgrep='xzgrep --color=auto'
alias zegrep='zegrep --color=auto'
alias zfgrep='zfgrep --color=auto'
alias zgrep='zgrep --color=auto'

# git aliases =================================================================

alias gst='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -v'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gd='git diff'
alias gds='git diff --staged'
alias gb='git branch'
alias glo='git log --oneline --decorate --graph'
alias gl='git pull'
alias gp='git push'
alias gpf='git push --force-with-lease'

# project aliases =============================================================

alias scam='scampi'
alias scm='scampi'

# `--` ends the options, or `-=...` would be read as a flag.
alias -- -='cd -'

alias mkdir='mkdir -p'

alias ip='ip -c'

alias vim='nvim'
alias fvim='nvim "$(fzf)"'
alias vimdiff='nvim -d'

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --theme=gruvbox-dark'
fi

alias df='df -h'
alias du='du -h'

alias hexdump='hexdump -C'

alias md='glow'
alias fm='yazi'
alias jj='just'
alias lg='lazygit'

alias cz='chezmoi'

# tmuxinator's verbs over tmuxp, which has `load` and no stop at all.
mux() {
  case "$1" in
    start) shift; tmuxp load -y "${1:-.}" ;;
    stop) shift; tmux kill-session -t "${1:-$(basename "$PWD")}" ;;
    *) tmuxp "$@" ;;
  esac
}

alias k9s='k9s --logoless --splashless --refresh 0.75'

alias 'cd..'='cd ..'
alias 'cd~'='cd ~'

alias please='sudo'
