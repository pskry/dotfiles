#
# ~/.aliases
#
# vim:ft=sh:fenc=utf-8

# ls aliases ===============================================================

if which eza &>/dev/null; then
  alias ls='eza -g --group-directories-first --icons --color=auto'
elif which exa &>/dev/null; then
  # exa does not list pwd and parent directory with only one '-a' flag
  alias ls='exa -a -g --group-directories-first --icons --color=auto'
elif [ "$(uname -s)" == "Linux" ]; then
  alias ls='ls --group-directories-first --color=auto'
else
  # /bin/ls on FreeBSD (and macOS/Darwin) does not have --group-directories-first :(
  alias ls='ls --color=auto'
fi

alias l='ls -l'
alias ll='ls -la'

# grep aliases =============================================================

# NOTE: do NOT alias grep to rg. rg's flags are not grep's -- notably `-r` is
# --replace, not --recursive, so a reflex `grep -rln foo` silently rewrites the
# printed matches instead of erroring. That invented a symbol that never existed
# and cost a bogus checklist item on scampi#454. Use `rg` by name.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias xzegrep='xzegrep --color=auto'
alias xzfgrep='xzfgrep --color=auto'
alias xzgrep='xzgrep --color=auto'
alias zegrep='zegrep --color=auto'
alias zfgrep='zfgrep --color=auto'
alias zgrep='zgrep --color=auto'

# git aliases =================================================================
#
# Written out rather than taken from OMZP::git, which brought about 150 of them for
# the dozen anyone uses, and only in zsh. These are plain sh, so bash gets them from
# the same file.

alias gst='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -v'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gd='git diff'
alias gds='git diff --staged'
alias gb='git branch'
alias glo='git log --oneline --decorate --graph'
# Pull and push, spelled the way OMZ spelled them, because the muscle memory is real.
alias gl='git pull'
alias gp='git push'
# --force-with-lease, never --force: it refuses when the remote moved under you,
# which is the one case where forcing destroys somebody else's commit.
alias gpf='git push --force-with-lease'

# project aliases =============================================================

alias scam='scampi'
alias scm='scampi'

# Type '-' to return to your previous dir.
# '--' signifies the end of options.
# Otherwise, '-=...' would be interpreted as a flag.
alias -- -='cd -'

if which z &>/dev/null; then
  alias cd='z'
fi

alias mkdir='mkdir -p'

alias ip='ip -c'

alias vim='nvim'
alias fvim='nvim "$(fzf)"'
alias vimdiff='nvim -d'

if which bat &>/dev/null; then
  alias cat='bat --theme=gruvbox-dark'
fi

alias df='df -h'
alias du='du -h'

alias hexdump='hexdump -C'

alias md='glow'
alias fm='yazi'
alias jj='just'
alias lg='lazygit'

alias cz='chezmoi'
alias mux='tmuxp'

alias k9s='k9s --logoless --splashless --refresh 0.75'

alias 'cd..'='cd ..'
alias 'cd~'='cd ~'

alias please='sudo'
