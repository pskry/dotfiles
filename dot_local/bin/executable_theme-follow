#!/usr/bin/env bash
# Linux: watches the color-scheme setting and moves everything that cannot watch it itself
# onto the matching palette in ~/.config/theme. Whatever changed the setting, a key, `theme`
# or a settings app, this is what makes the rest follow.
set -uo pipefail

dir="$HOME/.config/theme"

apply() {
  local mode=dark
  [[ "$(gsettings get org.gnome.desktop.interface color-scheme)" == "'prefer-light'" ]] && mode=light
  [[ "$(readlink "$dir/current" 2>/dev/null)" == "$mode" && "${1:-}" != force ]] && return

  ln -sfn "$mode" "$dir/current"

  # Also restarts waybar, as sway's bar. No SIGUSR2 on top: it lands on the fresh process
  # before its handler exists, and the default action is to terminate.
  swaymsg reload >/dev/null 2>&1
  makoctl reload 2>/dev/null
  # wob reads its colors once, at start.
  pkill -x wob && swaymsg exec "$HOME/.local/bin/osd daemon" >/dev/null 2>&1

  # btop OWNS its config: it rewrites btop.conf on exit, so chezmoi cannot manage the file
  # without fighting it. Only the one line is touched, and only when btop is not running,
  # or the running instance would write its own value back over this on quit.
  local conf="$HOME/.config/btop/btop.conf"
  if [[ -f $conf ]] && ! pgrep -x btop >/dev/null; then
    sed -i "s/^color_theme = .*/color_theme = \"gruvbox_$mode\"/" "$conf"
  fi
}

# Plain Adwaita, never Adwaita-dark: GTK takes the dark variant from color-scheme itself, and
# Electron (Signal) treats the -dark NAME as light, so switching it made Signal lag a step.
gsettings set org.gnome.desktop.interface gtk-theme Adwaita

apply force
gsettings monitor org.gnome.desktop.interface color-scheme | while read -r _; do apply; done
