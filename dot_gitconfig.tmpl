[user]
	name = pskry
	email = peter@skrypalle.dk
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[alias]
	difft = difftool --tool=nvimdiff
[merge]
	tool = nvimdiff2
[gpg]
	format = ssh
	minTrustLevel = undefined
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[log]
	showSignature = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = gruvbox-dark
[diff]
	colorMoved = default
