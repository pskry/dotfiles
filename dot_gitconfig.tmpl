{{- /*
     Identity follows the MACHINE, not the person: a commit authored on an employer's
     laptop carries their address, one from mine carries mine.

     THIS REPO IS PUBLIC, so the work identity is not in it. A machine that is not in
     personal_hosts gets no [user] block here; it includes identity.local at the BOTTOM
     of this file instead, seeded on that machine from the account itself.

     At the bottom on purpose. Includes are expanded in place and the last value wins, so
     a file included here can override anything above it, which is what lets a machine
     with no signing key turn commit.gpgsign off. Included at the top it could not.

     Keyed off personal_hosts, so an unknown machine is treated as work. That is the safe
     direction to fail: no identity is an error git names in one line, the wrong one is a
     personal address in an employer's history.
*/ -}}
{{- if has .chezmoi.hostname .personal_hosts }}
[user]
	name = pskry
	email = peter@skrypalle.dk
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
{{- end }}
[init]
	defaultBranch = main
[alias]
	difft = difftool --tool=nvimdiff
[merge]
	tool = nvimdiff2
[gpg]
	format = ssh
	minTrustLevel = undefined
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[log]
	showSignature = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = gruvbox-dark
[diff]
	colorMoved = default
{{- if not (has .chezmoi.hostname .personal_hosts) }}

# Seeded by the workstation role from the account itself, never from this repo. Carries
# the [user] block, and turns signing off where that account has no key.
[include]
	path = {{ .chezmoi.homeDir }}/.config/git/identity.local
{{- end }}
